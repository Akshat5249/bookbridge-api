# BookBridge API configuration (all optional; defaults shown)
# Copy to .env to override. The app must start with no .env present.

BOOKBRIDGE_UPSTREAM_BASE_URL=https://books.toscrape.com
BOOKBRIDGE_USER_AGENT=BookBridgeAPI/1.0 (educational demo; contact: you@example.com)

BOOKBRIDGE_CONNECT_TIMEOUT_SECONDS=3
BOOKBRIDGE_READ_TIMEOUT_SECONDS=8
BOOKBRIDGE_MAX_RETRIES=2
BOOKBRIDGE_RETRY_BACKOFF_SECONDS=0.5

BOOKBRIDGE_MAX_CONCURRENT_REQUESTS=4
BOOKBRIDGE_MIN_REQUEST_INTERVAL_SECONDS=0.1

BOOKBRIDGE_DETAIL_CACHE_TTL_SECONDS=300
BOOKBRIDGE_INDEX_TTL_SECONDS=900
BOOKBRIDGE_INDEX_WARMUP_ON_STARTUP=false

BOOKBRIDGE_RESPECT_ROBOTS_TXT=true
BOOKBRIDGE_LOG_LEVEL=INFO
